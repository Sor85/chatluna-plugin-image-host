{
    "name": "chatluna-plugin-image-host",
    "version": "0.0.3",
    "description": "图床插件：在 WebUI 侧栏上传并分类管理图片，自动注入提示词供 Bot 按 HTTP 地址发图，「地址/分类名」随机返回一张，「地址/分类名/文件名」返回指定图片",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Sor85/chatluna-plugin-image-host.git"
    },
    "homepage": "https://github.com/Sor85/chatluna-plugin-image-host#readme",
    "bugs": {
        "url": "https://github.com/Sor85/chatluna-plugin-image-host/issues"
    },
    "keywords": [
        "chatluna-plugin",
        "chatluna",
        "image",
        "gallery",
        "sticker"
    ],
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        },
        "./package.json": "./package.json",
        "./client": {
            "types": "./client/index.ts",
            "default": "./client/index.ts"
        }
    },
    "files": [
        "lib",
        "dist",
        "client",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "sync": "node scripts/sync-to-v2.mjs",
        "release": "node scripts/publish.mjs",
        "build": "yakumo build",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.client.json"
    },
    "peerDependencies": {
        "@chatluna/protocol": ">=2.0.0-alpha.0",
        "@chatluna/schema": ">=2.0.0-alpha.0",
        "@chatluna/server": ">=2.0.0-alpha.0",
        "@chatluna/transform": ">=2.0.0-alpha.0",
        "@chatluna/ui-server": ">=2.0.0-alpha.0",
        "@chatluna/utils": ">=2.0.0-alpha.0",
        "cordis": "4.0.0-rc.12"
    },
    "devDependencies": {
        "@chatluna/agent": "workspace:*",
        "@chatluna/message": "workspace:*",
        "@chatluna/prompt": "workspace:*",
        "@chatluna/protocol": "workspace:*",
        "@chatluna/schema": "workspace:*",
        "@chatluna/server": "workspace:*",
        "@chatluna/tool": "workspace:*",
        "@chatluna/transform": "workspace:*",
        "@chatluna/ui-client": "workspace:*",
        "@chatluna/ui-kit": "workspace:*",
        "@chatluna/ui-server": "workspace:*",
        "@chatluna/utils": "workspace:*",
        "@cordisjs/plugin-server": "^1.7.0",
        "@cordisjs/unyaml": "^3.0.0",
        "@types/node": "^24.0.0",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "cordis": "4.0.0-rc.12",
        "lucide-react": "^1.31.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router": "^8.3.0",
        "typescript": "7.0.2",
        "vitest": "^3.2.4"
    },
    "cordis": {
        "description": {
            "zh": "图床插件：在 WebUI 侧栏上传并分类管理图片，自动注入提示词供 Bot 按 HTTP 地址发图，「地址/分类名」随机返回一张，「地址/分类名/文件名」返回指定图片",
            "en": "Image host: upload and categorize images in a WebUI page and let the bot send them by HTTP URL through an injected prompt; \"URL/category\" returns a random image and \"URL/category/file\" a specific one"
        },
        "service": {
            "optional": [
                "agents",
                "tools",
                "server",
                "chatluna_server",
                "chatluna_webui"
            ]
        }
    }
}
