{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": ["vite/client", "@cordisjs/unyaml/types"],
        "rootDir": ".",
        "noEmit": true,
        "resolveJsonModule": true,
        "composite": false,
        "incremental": false,
        "declaration": false,
        "declarationMap": false,
        "emitDeclarationOnly": false
    },
    "include": ["client", "src"]
}
